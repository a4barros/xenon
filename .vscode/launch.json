{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: debug locally",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host", "127.0.0.1",
        "--port", "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "DATABASE_URL": "postgresql://xenon:xenon@localhost:5432/xenon"
      },
      "justMyCode": true,
      "subProcess": true
    }
  ]
}
